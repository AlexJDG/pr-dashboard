# Copy to .env and fill in. Environment variables already set take precedence over this file.

# Required: the repo to watch, as owner/name
PR_DASHBOARD_REPO=

# Optional: browser executable for launch.sh (defaults to Chrome's Windows install, seen from WSL). For example:
#   WSL, Chrome:  /mnt/c/Program Files/Google/Chrome/Application/chrome.exe
#   WSL, Edge:    /mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
#   Linux:        google-chrome, chromium or firefox
#   macOS:        /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PR_DASHBOARD_BROWSER=

# Optional: browser profile for launch.sh, for Chromium-based browsers (defaults to Default)
PR_DASHBOARD_BROWSER_PROFILE=

# Optional: stop the server once no page has polled for this many seconds (launch.sh sets 180)
IDLE_EXIT_SECONDS=

# Optional: 1 to exit with code 75 when a server file changes, for a wrapper to restart it (launch.sh sets 1)
SELF_RESTART=
